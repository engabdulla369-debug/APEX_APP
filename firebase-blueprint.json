      "description": "Per-user assignment checklist and solution upload metadata"
    },
    "/quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/Quiz" },
      "description": "Practice quizzes with MCQ and True/False questions"
    },
    "/users/{userId}/quiz_attempts/{attemptId}": {
