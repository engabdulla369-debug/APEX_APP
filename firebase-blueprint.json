  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin role marker documents"
    },
    "/batch_config/{configId}": {
      "schema": { "$ref": "#/entities/BatchConfig" },
      "description": "Batch verification settings"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles containing PII and settings"
    },
    "/join_requests/{userId}": {
      "schema": { "$ref": "#/entities/JoinRequest" },
      "description": "Batch membership directory and pending approvals"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Urgent batch ticker announcements and official circulars"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Academic courses by year and term"
    },
    "/schedule_entries/{entryId}": {
      "schema": { "$ref": "#/entities/ScheduleEntry" },
      "description": "Daily lectures and sections schedule"
    },
    "/materials/{materialId}": {
      "schema": { "$ref": "#/entities/CourseMaterial" },
      "description": "Course files, summaries, references, videos, and external links"
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Batch assignments and deadlines"
    },
    "/users/{userId}/assignment_progress/{assignmentId}": {
