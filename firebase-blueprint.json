      "required": [
        "userId",
        "displayName",
        "email",
        "studentRecordNumber",
        "department",
        "academicYear",
        "term",
        "role",
        "approvalStatus",
        "batchId",
        "darkMode",
        "notifyLectures",
        "notifyAssignments",
        "createdAt",
        "updatedAt"
      ]
    },
