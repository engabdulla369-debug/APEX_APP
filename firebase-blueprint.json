{
  "entities": {
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Explicitly grants administrator privileges to a user UID.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Admin user UID" },
        "grantedBy": { "type": "string", "description": "UID of admin who granted access" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "grantedBy", "createdAt"]
    },
    "BatchConfig": {
      "title": "BatchConfig",
      "description": "Batch metadata and verification join code managed by admins.",
      "type": "object",
      "properties": {
        "batchId": { "type": "string" },
        "batchName": { "type": "string" },
        "joinCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["batchId", "batchName", "joinCode", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated student/TA/rep profile with role, approval status, and preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "studentRecordNumber": { "type": "string" },
        "department": { "type": "string" },
        "academicYear": { "type": "integer" },
        "term": { "type": "integer" },
