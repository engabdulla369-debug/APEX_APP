        "notifyLectures": { "type": "boolean" },
        "notifyAssignments": { "type": "boolean" },
        "focusPoints": { "type": "integer" },
        "totalStudySeconds": { "type": "integer" },
        "pomodoroSessionsCompleted": { "type": "integer" },
        "longestSessionSeconds": { "type": "integer" },
