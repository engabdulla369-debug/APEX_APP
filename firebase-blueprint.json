      "description": "Per-user quiz attempt results"
    },
    "/users/{userId}/study_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySession" },
      "description": "Per-user study timer and Pomodoro sessions"
    },
    "/study_leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Non-PII public study leaderboard"
    },
    "/chat_channels/{channelId}": {
      "schema": { "$ref": "#/entities/ChatChannel" },
      "description": "General batch chat, course channels, and project team rooms"
    },
    "/chat_channels/{channelId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside chat channels and project rooms"
    },
    "/meeting_rooms/{roomId}": {
      "schema": { "$ref": "#/entities/MeetingRoom" },
      "description": "Mini meeting rooms for fast project collaboration"
    },
    "/meeting_rooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Live discussion messages inside mini meeting rooms"
    },
    "/dynamic_modules/{moduleId}": {
      "schema": { "$ref": "#/entities/DynamicModule" },
      "description": "Dynamic UI cards, tools, and official banners configured in-app"
    },
    "/users/{userId}/flashcards/{cardId}": {
      "schema": { "$ref": "#/entities/Flashcard" },
      "description": "Per-student spaced repetition flashcards"
    },
    "/users/{userId}/personal_tasks/{taskId}": {
      "schema": { "$ref": "#/entities/PersonalTask" },
      "description": "Per-student daily To-Do tasks with priorities and deadlines"
    },
    "/global_references/{refId}": {
      "schema": { "$ref": "#/entities/GlobalReference" },
      "description": "Curated global academic references and MOOCs"
    }
  }
}
