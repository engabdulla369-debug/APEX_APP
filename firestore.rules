      }
    }

    match /meeting_rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) && isApprovedMember();
      allow list: if isSignedIn() && resource.data.batchId == 'eng_2026';
      allow create: if isSignedIn() && isValidId(roomId) &&
        isApprovedMember() &&
        isValidMeetingRoom(incoming()) &&
        incoming().hostId == request.auth.uid &&
        incoming().batchId == 'eng_2026' &&
        incoming().keys().hasAll([
          'title', 'topic', 'batchId', 'hostId', 'hostName', 'status',
          'participantUids', 'participantNames', 'raisedHandUids', 'agendaNotes',
          'startedAtMillis', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'topic', 'courseTitle', 'batchId', 'hostId', 'hostName', 'status',
          'participantUids', 'participantNames', 'raisedHandUids', 'agendaNotes',
          'meetingUrl', 'startedAtMillis', 'createdAt', 'updatedAt'
        ]);
      allow update: if isSignedIn() && isValidId(roomId) &&
        isApprovedMember() &&
        isValidMeetingRoom(incoming()) &&
        incoming().hostId == existing().hostId &&
        incoming().batchId == existing().batchId &&
        incoming().startedAtMillis == existing().startedAtMillis &&
        incoming().createdAt == existing().createdAt && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'participantUids', 'participantNames', 'raisedHandUids', 'agendaNotes', 'updatedAt'
          ]) ||
          (
            (existing().hostId == request.auth.uid || isBatchRep()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'topic', 'courseTitle', 'status', 'meetingUrl',
              'participantUids', 'participantNames', 'raisedHandUids', 'agendaNotes', 'updatedAt'
            ])
          )
        );
      allow delete: if isSignedIn() && isValidId(roomId) && (existing().hostId == request.auth.uid || isBatchRep());

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId) && isApprovedMember();
        allow list: if isSignedIn() && resource.data.batchId == 'eng_2026';
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(messageId) &&
          isApprovedMember() &&
          isValidChatMessage(incoming()) &&
          incoming().channelId == roomId &&
          incoming().senderId == request.auth.uid &&
          incoming().batchId == 'eng_2026' &&
          exists(/databases/$(database)/documents/meeting_rooms/$(roomId)) &&
          incoming().keys().hasAll([
            'channelId', 'batchId', 'senderId', 'senderName', 'senderRole', 'text', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'channelId', 'batchId', 'senderId', 'senderName', 'senderRole', 'text',
            'attachmentName', 'attachmentUrl', 'createdAt', 'updatedAt'
          ]);
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(messageId) &&
          (existing().senderId == request.auth.uid || isBatchRep());
      }
    }

    match /dynamic_modules/{moduleId} {
      allow get: if isSignedIn() && isValidId(moduleId) && isApprovedMember();
      allow list: if isSignedIn() && resource.data.batchId == 'eng_2026';
      allow create: if isSignedIn() && isValidId(moduleId) &&
        isBatchRep() &&
        isValidDynamicModule(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().batchId == 'eng_2026' &&
        incoming().keys().hasAll([
          'title', 'subtitle', 'moduleType', 'iconKey', 'accentHex',
          'actionType', 'actionPayload', 'sortOrder', 'enabled', 'batchId',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'subtitle', 'moduleType', 'iconKey', 'accentHex',
          'actionType', 'actionPayload', 'sortOrder', 'enabled', 'batchId',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ]);
      allow update: if isSignedIn() && isValidId(moduleId) &&
        isBatchRep() &&
        isValidDynamicModule(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().batchId == existing().batchId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subtitle', 'moduleType', 'iconKey', 'accentHex',
          'actionType', 'actionPayload', 'sortOrder', 'enabled', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(moduleId) && isBatchRep();
    }

    match /global_references/{refId} {
      allow get: if isSignedIn() && isValidId(refId) && isApprovedMember();
      allow list: if isSignedIn() && resource.data.batchId == 'eng_2026';
      allow create: if isSignedIn() && isValidId(refId) &&
        isApprovedMember() &&
        isValidGlobalReference(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().batchId == 'eng_2026' &&
        incoming().keys().hasAll([
          'title', 'provider', 'subject', 'description', 'url',
          'languageCode', 'batchId', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'provider', 'subject', 'description', 'url',
          'languageCode', 'batchId', 'createdBy', 'createdAt', 'updatedAt'
        ]);
      allow update: if isSignedIn() && isValidId(refId) &&
        isApprovedMember() &&
        (existing().createdBy == request.auth.uid || isBatchRep()) &&
        isValidGlobalReference(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().batchId == existing().batchId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'provider', 'subject', 'description', 'url', 'languageCode', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(refId) &&
        (existing().createdBy == request.auth.uid || isBatchRep());
    }
  }
}
